# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=venture_ai_db

# Open-Source LLM Configuration (OpenAI-compatible)
# Options:
# 1. Local Ollama: LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=llama3.1:8b or qwen2.5:7b, LLM_API_KEY=ollama
# 2. Groq Cloud:   LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=llama-3.1-70b-versatile, LLM_API_KEY=gsk_...
# 3. vLLM / Local: LLM_BASE_URL=http://localhost:8000/v1, LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b
